library(tidyverse)
load("naic_asset.rta")
temp <- MyData |> select(COCODE, COMPANY_NAME, COMPANY_TYPE_DESC, CURRENT_YEAR, YEAR, LINE)
longdata <- temp |>
filter(LINE%in%c("Bonds", "CashHandDeposit", "Stocks_Com","Total"))
library(tidyr)
widedata <- longdata |>
pivot_wider(
id_cols = c(COCODE, COMPANY_NAME, COMPANY_TYPE_DESC, YEAR),
names_from = LINE,
values_from = CURRENT_YEAR
) |>
filter(Total > 0)  # keep only positive total assets
library(tidyr)
widedata <- longdata |>
pivot_wider(
id_cols = c(COCODE, COMPANY_NAME, COMPANY_TYPE_DESC, YEAR),
names_from = LINE,
values_from = CURRENT_YEAR
) |>
filter(Total > 0)
print(widedata)
widedata <- widedata |>
mutate(
bondRatio = Bonds/Total,
stockRatio = Stocks_Com/Total,
YEAR = factor(YEAR),
COMPANY_TYPE_DESC = factor(COMPANY_TYPE_DESC))
print(widedata)
longdata <- widedata |>
pivot_longer(
cols = c(bondRatio, Bonds, CashHandDeposit, stockRatio, Stocks_Com, Total),
names_to = "name",
values_to = "value")
print(longdata)
library(ggplot2)
longdata |>
filter(name == "Total") |>
ggplot(aes(x = YEAR, y = value)) +
geom_point() +
geom_line(group = 1) +
theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
labs(title = "Total Assets Over Time", x = "Year", y = "Total Assets")
